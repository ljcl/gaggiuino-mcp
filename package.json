{
  "name": "gaggiuino-mcp",
  "version": "3.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage && bun scripts/coverage-ratchet.ts",
    "coverage:summary": "bun scripts/coverage-summary.ts",
    "size": "bun scripts/bundle-size.ts",
    "test:stories": "vitest run --config vitest.stories.config.ts --project storybook",
    "test:stories:coverage": "vitest run --config vitest.stories.config.ts --project storybook --coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "turbo run dev",
    "fake-machine": "bun scripts/fake-machine.ts",
    "boundaries": "turbo boundaries",
    "check": "turbo run lint test typecheck build knip && turbo boundaries && bun run size",
    "check:affected": "turbo run lint test typecheck build knip --affected && turbo boundaries && bun run size",
    "knip": "knip",
    "knip:summary": "knip --reporter json --no-exit-code | bun scripts/knip-summary.ts",
    "storybook": "turbo run storybook --filter=@gaggiuino/storybook",
    "build-storybook": "turbo run build:storybook --filter=@gaggiuino/storybook",
    "shots": "bun scripts/story-shots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@storybook/addon-vitest": "10.5.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "knip": "6.29.0",
    "playwright": "1.62.1",
    "turbo": "2.10.7",
    "vitest": "4.1.10"
  }
}
