# Dependencies (installed inside container)
**/node_modules/

# Build artifacts (built inside container)
**/dist/
**/.turbo/

# Git
.git/
.gitignore

# Worktrees
.worktrees/

# Coverage
coverage/
coverage-stories/

# Test artifacts
test-results/
story-shots/

# Environment
.env
.env.*
!.env.example

# User local overrides — never bake personal config into the image
*.local.yaml

# Test scaffolding. The runner COPYs all of apps/server/src, so without these
# every test file, every fixture and the msw setup shipped in the published
# image — none of it reachable at runtime (msw is a devDependency the runner
# never installs), all of it read as part of the server by anyone opening the
# image. The fake machine's payloads live in __fixtures__ and are excluded by
# the same rule; its executable is at repo-root scripts/, which the build
# context never contained.
#
# Safe to exclude from the *build* stage too: nothing in the app bundle's import
# graph reaches a fixture — packages/shot-graph/src/phases.ts mentions
# chart-data.ts only in a comment — and `turbo build` runs no tests.
**/*.test.ts
**/__fixtures__/
apps/server/src/test-setup.ts

# Docs
docs/
*.md
!README.md

# Agent surface
.agents/
.claude/

# IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Docker
**/Dockerfile
docker-compose.yml
.dockerignore

# Storybook build output
**/storybook-static/
