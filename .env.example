# Gaggiuino MCP Remote Server Configuration
# Copy this file to .env next to docker-compose.yml (or to apps/server/.env in a
# repo checkout — compose reads both) and customize the values

# ============================================================================
# REQUIRED: Gaggiuino Machine URL
# ============================================================================
# The URL of your Gaggiuino espresso machine.
# Use the hostname if mDNS works on your network, otherwise use the IP address.
#
# Examples:
#   GAGGIUINO_URL=http://gaggiuino.local
#   GAGGIUINO_URL=http://192.168.1.100
GAGGIUINO_URL=http://gaggiuino.local

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================
# Port the MCP server will listen on
# Default: 8000
PORT=8000

# Network interface to bind to
# 0.0.0.0 means accept connections from any network interface
# 127.0.0.1 would only accept local connections
# Default: 0.0.0.0
HOST=0.0.0.0

# ============================================================================
# SECURITY: OAuth — the way to authenticate a Claude connector
# ============================================================================
# The public origin clients reach this server on, with no path, query or
# fragment. It is what the server advertises as its OAuth `resource`, so it must
# match the URL you type into Claude exactly, and it cannot be guessed from the
# request: a tunnel terminates TLS and hands the container plain HTTP.
#
# Setting this and MCP_OAUTH_SECRET together turns on OAuth. /mcp then requires
# an access token, and the server serves the discovery documents Claude needs to
# obtain one. Setting only one of the two fails at startup rather than silently
# leaving the endpoint on its previous setting.
#
# Must be https, and must be a bare origin — https://box.tailnet.ts.net, not
# https://box.tailnet.ts.net/mcp. The server appends /mcp itself and prints the
# advertised value at startup so you can check it against what Claude has.
# Default: unset (OAuth off)
#
# Example:
#   MCP_PUBLIC_URL=https://gaggiuino.tail1234.ts.net
#MCP_PUBLIC_URL=

# The key every access and refresh token is signed with. Keep it stable:
# signing keys are derived from it rather than kept in any store, so an
# unchanged value means a restart does not sign you out of your phone, and a
# changed value revokes every token.
#
# Generate one with:
#   openssl rand -hex 32
#
# Must be at least 32 characters. Blank or whitespace-only counts as unset.
# Default: unset (OAuth off)
#MCP_OAUTH_SECRET=

# scrypt hash of the passphrase you type on the consent page when connecting a
# client. Required whenever OAuth is on — without it the consent page would
# hand a token to anyone who reached the URL, so the server refuses to start.
#
# Never put the passphrase itself here. Generate the hash with:
#   cd apps/server && bun run hash-passphrase
#
# It prompts on stderr and prints the whole `MCP_OAUTH_PASSPHRASE_HASH=...`
# line on stdout, so you can append it straight to this file. The value looks
# like `scrypt$16384$8$1$<salt>$<hash>`.
#
# SINGLE QUOTES, and they are not optional. The salt and hash are base64url, so
# `$<salt>` and `$<hash>` are valid variable references — docker compose
# substitutes them away and warns `The "<salt>" variable is not set. Defaulting
# to a blank string.` The truncated value then fails validation and the server
# refuses to start. Double quotes do NOT help: compose's dotenv parser expands
# inside them, and only single quotes are literal. The generator emits them for
# you; keep them if you paste the value by hand.
#   MCP_OAUTH_PASSPHRASE_HASH='scrypt$16384$8$1$<salt>$<hash>'
# Default: unset (OAuth off)
#MCP_OAUTH_PASSPHRASE_HASH=

# ============================================================================
# SECURITY: OAuth — delegating to your own identity provider (optional)
# ============================================================================
# Set this to hand token issuing to an authorization server you already run —
# Authentik, Authelia, Keycloak, Zitadel, Kanidm, tsidp — instead of the one
# built into this container. Leave it unset and the built-in one is used, which
# is the default and needs nothing but the three variables above.
#
# When it IS set, this server runs as a resource server only: it stops serving
# /oauth/authorize, /oauth/token and /.well-known/oauth-authorization-server
# entirely, and its protected-resource metadata points Claude at your issuer.
# It signs nothing, so MCP_OAUTH_SECRET and MCP_OAUTH_PASSPHRASE_HASH have no
# purpose here — setting either alongside this one is refused at startup rather
# than ignored, because ignoring it would leave you believing in a consent page
# that is never rendered.
#
# MCP_PUBLIC_URL is still required: it is what the token's audience must match.
#
# Must be https, and must be the issuer identifier exactly as your IdP
# publishes it in its own discovery document — a path is fine and normal
# (Keycloak and Authentik both use one), but a trailing slash, query or
# fragment is not. The value is compared byte-for-byte against the `iss` claim.
#
# Four things must be true on the IdP side, whatever the product:
#   1. It advertises S256 in code_challenge_methods_supported.
#   2. Its discovery endpoint is reachable from Anthropic's egress range,
#      160.79.104.0/21 — a WAF in front of your IdP breaks the flow even when
#      this server is perfectly reachable.
#   3. Tokens carry an audience equal to MCP_PUBLIC_URL + /mcp. Keycloak needs
#      an Audience-mapper client scope for this; it has no RFC 8707 support.
#   4. A client exists with redirect URI
#      https://claude.ai/api/mcp/auth_callback (plus port-agnostic
#      http://localhost/callback and http://127.0.0.1/callback for Claude Code).
#
# Dynamic client registration is NOT required — Claude accepts a client ID
# pasted into the connector dialog, so an IdP without DCR is perfectly usable
# with one manually created client.
#
# Tokens must be signed RS256 or ES256; this server verifies no other algorithm.
# Default: unset (the built-in authorization server runs)
#
# Examples:
#   MCP_OAUTH_ISSUER=https://idp.example.com/realms/home
#   MCP_OAUTH_ISSUER=https://idp.example.com/application/o/gaggiuino
#MCP_OAUTH_ISSUER=

# Browser origins allowed to call /mcp, comma-separated. Requests carrying no
# Origin header at all — Claude Desktop, curl, anything that is not a browser —
# are always allowed, so an empty list blocks only browser-initiated
# cross-origin calls and is the right setting for almost everyone. Use `*` to
# allow any origin. See README > Securing the endpoint for why a token alone
# does not cover this.
# Default: empty
#
# Example:
#   MCP_ALLOWED_ORIGINS=https://claude.ai,https://app.example.com
MCP_ALLOWED_ORIGINS=

# Host header values to accept, comma-separated. Empty disables the check
# entirely. Match the value the client sends, including the port. Worth setting
# when you terminate a tunnel or reverse proxy at a known hostname.
# Default: empty (any Host accepted)
#
# Example:
#   MCP_ALLOWED_HOSTS=gaggiuino.example.com,localhost:8000
MCP_ALLOWED_HOSTS=

# ============================================================================
# OPTIONAL: Logging
# ============================================================================
# Verbosity of the JSON logs on stderr (one object per line).
# Anything unrecognized falls back to info.
# Values: debug, info, warn, error, silent
# Default: info
LOG_LEVEL=info
